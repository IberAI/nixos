#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v nix >/dev/null 2>&1; then
  echo "nix is required." >&2
  exit 1
fi

mkdir -p secrets

if [ ! -f .sops.yaml ]; then
  cp .sops.yaml.example .sops.yaml
  echo "Created .sops.yaml from the example."
fi

echo
echo "Host age public key:"
nix shell nixpkgs#ssh-to-age -c ssh-to-age < /etc/ssh/ssh_host_ed25519_key.pub
echo
echo "Replace age1replace-with-age-public-key in .sops.yaml with the key above."
echo "Then create secrets/secrets.yaml with:"
echo "  scripts/secrets-edit"
