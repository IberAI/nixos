#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -f .sops.yaml ]; then
  echo "Missing .sops.yaml. Run scripts/secrets-bootstrap first." >&2
  exit 1
fi

if [ ! -f secrets/secrets.yaml ]; then
  cp secrets/secrets.example.yaml secrets/secrets.yaml
fi

exec nix shell nixpkgs#sops -c sops secrets/secrets.yaml
